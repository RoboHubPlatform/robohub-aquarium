fn ListWaterChanges(tank_id: i64, db: SqlDb, out: Slice[AquariumWaterChanges], capacity: u32) Result[u32, SqlError] {
    if capacity == 0 {
        return Err[u32, SqlError](SqlError{ "no room for rows", -1 })
    }
    let wrote: u32 = sql_list_water_changes(tank_id, db, out, capacity)
    let failure: string = sql_failed(db)
    if failure != "" {
        return Err[u32, SqlError](SqlError{ failure, -1 })
    }
    return Ok[u32, SqlError](wrote)
}

fn InsertLivestock(tank_id: string, kind: string, species: string, count: string, added_at: string, notes: string, db: SqlDb) Result[u32, SqlError] {
    let changed: u32 = sql_insert_livestock(tank_id, kind, species, count, added_at, notes, db)
    let failure: string = sql_failed(db)
    if failure != "" {
        return Err[u32, SqlError](SqlError{ failure, -1 })
    }
    return Ok[u32, SqlError](changed)
}

