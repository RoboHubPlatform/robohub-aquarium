module aquarium

/// The water parameters the aquarium knows: key|label|unit, one per line.
const AQUA_PARAMETERS: string = "temperature|Temperature|°C\nph|pH|\nkh|KH|°dH\ngh|GH|°dH\nno3|Nitrate NO₃|mg/L\nno2|Nitrite NO₂|mg/L\nnh3|Ammonia NH₃|mg/L\npo4|Phosphate PO₄|mg/L\n"

const AQUA_TANKS: u32 = 32
const AQUA_ROWS: u32 = 500

/* -------------------------------------------------------------------------- */
/*  Small things                                                              */
/* -------------------------------------------------------------------------- */

fn aqua_ignore(value: Result[u32, SqlError]) void {
}

fn aqua_form(body: string, name: string) string {
    return str_trim(form_field(body, name))
}

fn aqua_db_path() string {
    var workspace: string = getenv("ROBOHUB_APP_WORKSPACE")
    if workspace == "" {
        workspace = getenv("HOME") + "/.rho/aquarium"
    }
    let dir: string = workspace + "/data"
    if !rho_path_exists(dir) {
        ignore_u32(rho_exec("mkdir", "-p " + dir, "/dev/null"))
    }
    return dir + "/app.db"
}

fn aqua_open() Result[SqlDb, string] {
    let opened: Result[SqlDb, string] = sql_open(aqua_db_path())
    if opened.is_ok {
        ignore_u32(sql_apply(opened.ok, ""))
    }
    return opened
}

fn aqua_now() u32 {
    return rho_now_s()
}

// aqua_field is the field at an index of a `|`-separated line.
fn aqua_field(line: string, index: u32) string {
    var rest: string = line
    var i: u32 = 0
    while true {
        let at: i32 = rho_str_index_of(rest, "|")
        if i == index {
            if at < 0 {
                return rest
            }
            return rho_str_slice(rest, 0, u32(at))
        }
        if at < 0 {
            return ""
        }
        rest = rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
        i = i + 1
    }
    return ""
}

fn aqua_line(rest: string) string {
    let at: i32 = rho_str_index_of(rest, "\n")
    if at < 0 {
        return rest
    }
    return rho_str_slice(rest, 0, u32(at))
}

fn aqua_after_line(rest: string) string {
    let at: i32 = rho_str_index_of(rest, "\n")
    if at < 0 {
        return ""
    }
    return rho_str_slice(rest, u32(at) + 1, u32(rho_strlen(rest)) - u32(at) - 1)
}

// aqua_after_post is where a form that changed something sends the browser: the
// page again, by GET, with what happened as its message. A refresh then reloads
// the page rather than logging the test, using up the kit or completing the chore
// a second time.
fn aqua_after_post(path: string, tank: AquaTank, tab: string, message: string) Response {
    var target: string = path + "?tank=" + rho_int_to_str(tank.id)
    if tab != "" {
        target = target + "&tab=" + tab
    }
    return redirect(target + "&msg=" + str_url_encode(message))
}

/* -------------------------------------------------------------------------- */
/*  Numbers in thousandths                                                    */
/* -------------------------------------------------------------------------- */

struct AquaNumber {
    ok: bool
    milli: i64
}

// aqua_number reads a decimal written with a dot or a comma, in thousandths.
fn aqua_number(text: string) AquaNumber {
    return AquaNumber{ milli_valid(text), milli_parse(text) }
}

fn aqua_i64(value: i64) string {
    if value == 0 {
        return "0"
    }
    var rest: i64 = value
    var sign: string = ""
    if rest < 0 {
        sign = "-"
        rest = 0 - rest
    }
    var out: string = ""
    while rest > 0 {
        out = rho_str_slice("0123456789", u32(rest - (rest / 10) * 10), 1) + out
        rest = rest / 10
    }
    return sign + out
}

// aqua_round writes a reading to so many decimals, rounding half away from zero:
// a probe's 24.873 is 24.9.
fn aqua_round(text: string, places: u32) string {
    let value: AquaNumber = aqua_number(text)
    if !value.ok {
        return text
    }
    var unit_milli: i64 = 1000
    var i: u32 = 0
    while i < places {
        unit_milli = unit_milli / 10
        i = i + 1
    }
    var milli: i64 = value.milli
    var half: i64 = unit_milli / 2
    if milli < 0 {
        half = 0 - half
    }
    milli = ((milli + half) / unit_milli) * unit_milli
    return milli_format(milli)
}

/* -------------------------------------------------------------------------- */
/*  Parameters                                                                */
/* -------------------------------------------------------------------------- */

fn aqua_parameter_line(key: string) string {
    var rest: string = AQUA_PARAMETERS
    while rest != "" {
        let line: string = aqua_line(rest)
        rest = aqua_after_line(rest)
        if rho_str_eq(aqua_field(line, 0), key) {
            return line
        }
    }
    return ""
}

fn aqua_parameter_label(key: string) string {
    let line: string = aqua_parameter_line(key)
    if line == "" {
        return key
    }
    return aqua_field(line, 1)
}

fn aqua_parameter_unit(key: string) string {
    return aqua_field(aqua_parameter_line(key), 2)
}

fn aqua_parameter_choices() string {
    var out: string = ""
    var rest: string = AQUA_PARAMETERS
    while rest != "" {
        let line: string = aqua_line(rest)
        rest = aqua_after_line(rest)
        if line != "" {
            if out != "" {
                out = out + ","
            }
            out = out + aqua_field(line, 0) + "|" + aqua_field(line, 1)
        }
    }
    return out
}

/* -------------------------------------------------------------------------- */
/*  Tanks                                                                     */
/* -------------------------------------------------------------------------- */

/// A tank as the pages use it, or none when id is 0.
struct AquaTank {
    id: u32
    name: string
    handle: string
    volume: u32
    kind: string
    lights_on: string
    lights_off: string
    notes: string
}

fn aqua_no_tank() AquaTank {
    return AquaTank{ 0, "", "", 0, "", "", "", "" }
}

fn aqua_tank_of(row: AquariumTanks) AquaTank {
    return AquaTank{ u32(row.id), row.name, row.handle, u32(row.volumeL), row.typeValue,
        row.lightsOn, row.lightsOff, row.notes }
}

// aqua_tanks is every tank, as `id|name` lines, for a choice.
fn aqua_tank_choices() string {
    let opened: Result[SqlDb, string] = aqua_open()
    if !opened.is_ok {
        return ""
    }
    let rows: AquariumTanks[32]
    let slice: Slice[AquariumTanks] = Slice[AquariumTanks]{ Ptr[AquariumTanks](&rows[0]), AQUA_TANKS }
    let listed: Result[u32, SqlError] = ListTanks(opened.ok, slice, AQUA_TANKS)
    sql_close(opened.ok)
    var out: string = ""
    if listed.is_ok {
        var i: u32 = 0
        while i < listed.ok {
            if out != "" {
                out = out + ","
            }
            out = out + rho_int_to_str(u32(rows[i].id)) + "|" + rows[i].name
            i = i + 1
        }
    }
    return out
}

// aqua_tank is the tank a page is about: the one asked for by id, the one
// chosen in settings, or the first. A new installation has one, made at start.
fn aqua_tank(asked: u32) AquaTank {
    let opened: Result[SqlDb, string] = aqua_open()
    if !opened.is_ok {
        return aqua_no_tank()
    }
    let rows: AquariumTanks[32]
    let slice: Slice[AquariumTanks] = Slice[AquariumTanks]{ Ptr[AquariumTanks](&rows[0]), AQUA_TANKS }
    let listed: Result[u32, SqlError] = ListTanks(opened.ok, slice, AQUA_TANKS)
    sql_close(opened.ok)
    if !listed.is_ok || listed.ok == 0 {
        return aqua_no_tank()
    }
    var wanted: u32 = asked
    if wanted == 0 {
        wanted = rho_int_from_str(settings_get("aquarium.tank", "0"))
    }
    var i: u32 = 0
    while i < listed.ok {
        if u32(rows[i].id) == wanted {
            return aqua_tank_of(rows[i])
        }
        i = i + 1
    }
    return aqua_tank_of(rows[0])
}

fn aqua_tank_param(req: Request) AquaTank {
    return aqua_tank(rho_int_from_str(request_query_param(req, "tank")))
}

// aqua_type_label is a kind of tank as people say it.
fn aqua_type_label(kind: string) string {
    let label: string = str_trim(yaml.value(aqua_presets_path("targets"), "types." + kind + ".label"))
    if label == "" {
        return kind
    }
    return label
}

fn aqua_type_choices() string {
    var out: string = ""
    var rest: string = yaml.keys(aqua_presets_path("targets"), "types")
    while rest != "" {
        let kind: string = aqua_line(rest)
        rest = aqua_after_line(rest)
        if kind != "" {
            if out != "" {
                out = out + ","
            }
            out = out + kind + "|" + aqua_type_label(kind)
        }
    }
    return out
}

// aqua_add_tank makes a tank and seeds its targets from its kind.
fn aqua_add_tank(name: string, volume: u32, kind: string, lights_on: string, lights_off: string, notes: string) u32 {
    var handle: string = inventory_handle(name)
    if handle == "" {
        handle = "tank"
    }
    let opened: Result[SqlDb, string] = aqua_open()
    if !opened.is_ok {
        return 0
    }
    let db: SqlDb = opened.ok
    let added: Result[u32, SqlError] = InsertTank(name, handle, rho_int_to_str(volume), kind, lights_on, lights_off,
        notes, rho_int_to_str(aqua_now()), db)
    sql_close(db)
    if !added.is_ok || added.ok == 0 {
        return 0
    }
    let tank: AquaTank = aqua_tank_by_handle(handle)
    aqua_seed_targets(tank.id, kind, false)
    journal_info("tank", handle, "person", name + " added: " + rho_int_to_str(volume) + " L " + aqua_type_label(kind))
    return tank.id
}

fn aqua_tank_by_handle(handle: string) AquaTank {
    let opened: Result[SqlDb, string] = aqua_open()
    if !opened.is_ok {
        return aqua_no_tank()
    }
    let rows: AquariumTanks[32]
    let slice: Slice[AquariumTanks] = Slice[AquariumTanks]{ Ptr[AquariumTanks](&rows[0]), AQUA_TANKS }
    let listed: Result[u32, SqlError] = ListTanks(opened.ok, slice, AQUA_TANKS)
    sql_close(opened.ok)
    if listed.is_ok {
        var i: u32 = 0
        while i < listed.ok {
            if rho_str_eq(rows[i].handle, handle) {
                return aqua_tank_of(rows[i])
            }
            i = i + 1
        }
    }
    return aqua_no_tank()
}

/* -------------------------------------------------------------------------- */
/*  Targets                                                                   */
/* -------------------------------------------------------------------------- */

// aqua_presets_path is where a presets file the aquarium reads by path is put:
// the YAML reader takes a file, and the presets are embedded in the program.
fn aqua_presets_path(name: string) string {
    let path: string = aqua_db_path() + ".presets-" + name + ".yml"
    if !rho_path_exists(path) {
        ignore_bool(rho_write_text(path, rho_asset("aquarium", "presets/" + name + ".yml")))
    }
    return path
}

// aqua_presets_refresh writes the presets the aquarium reads by path again, at
// start, so a new version's presets are the ones read.
fn aqua_presets_refresh() void {
    ignore_bool(rho_write_text(aqua_db_path() + ".presets-targets.yml", rho_asset("aquarium", "presets/targets.yml")))
    ignore_bool(rho_write_text(aqua_db_path() + ".presets-roles.yml", rho_asset("aquarium", "presets/roles.yml")))
    ignore_bool(rho_write_text(aqua_db_path() + ".presets-rules.yml", rho_asset("aquarium", "presets/rules.yml")))
    ignore_bool(rho_write_text(aqua_db_path() + ".presets-schedule.yml", rho_asset("aquarium", "presets/schedule.yml")))
}

/// A target band, in thousandths; known is false when the tank has none.
struct AquaBand {
    known: bool
    low: i64
    high: i64
}

// aqua_seed_targets gives a tank the bands of its kind; with replace, the bands
// it already has are replaced too (its kind changed).
fn aqua_seed_targets(tank_id: u32, kind: string, replace: bool) void {
    let path: string = aqua_presets_path("targets")
    let opened: Result[SqlDb, string] = aqua_open()
    if !opened.is_ok {
        return
    }
    let db: SqlDb = opened.ok
    var rest: string = AQUA_PARAMETERS
    while rest != "" {
        let key: string = aqua_field(aqua_line(rest), 0)
        rest = aqua_after_line(rest)
        let band: string = str_trim(yaml.value(path, "types." + kind + "." + key))
        let dash: i32 = rho_str_index_of(band, "-")
        if key != "" && dash > 0 {
            let low: AquaNumber = aqua_number(rho_str_slice(band, 0, u32(dash)))
            let high: AquaNumber = aqua_number(rho_str_slice(band, u32(dash) + 1, u32(rho_strlen(band)) - u32(dash) - 1))
            if low.ok && high.ok {
                if replace {
                    aqua_ignore(PutTarget(rho_int_to_str(tank_id), key, aqua_i64(low.milli), aqua_i64(high.milli), db))
                } else {
                    aqua_ignore(SeedTarget(rho_int_to_str(tank_id), key, aqua_i64(low.milli), aqua_i64(high.milli), db))
                }
            }
        }
    }
    sql_close(db)
}

fn aqua_band(tank_id: u32, parameter: string) AquaBand {
    let opened: Result[SqlDb, string] = aqua_open()
    if !opened.is_ok {
        return AquaBand{ false, 0, 0 }
    }
    let rows: AquariumTargets[16]
    let slice: Slice[AquariumTargets] = Slice[AquariumTargets]{ Ptr[AquariumTargets](&rows[0]), 16 }
    let listed: Result[u32, SqlError] = ListTargets(i64(tank_id), opened.ok, slice, 16)
    sql_close(opened.ok)
    if listed.is_ok {
        var i: u32 = 0
        while i < listed.ok {
            if rho_str_eq(rows[i].parameter, parameter) {
                return AquaBand{ true, rows[i].lowMilli, rows[i].highMilli }
            }
            i = i + 1
        }
    }
    return AquaBand{ false, 0, 0 }
}

fn aqua_band_text(band: AquaBand) string {
    if !band.known {
        return "—"
    }
    return milli_format(band.low) + "–" + milli_format(band.high)
}

// aqua_in_band is "in", "low" or "high" for a value against a band, "" with none.
fn aqua_in_band(band: AquaBand, milli: i64) string {
    if !band.known {
        return ""
    }
    if milli < band.low {
        return "low"
    }
    if milli > band.high {
        return "high"
    }
    return "in"
}

/* -------------------------------------------------------------------------- */
/*  What the aquarium offers, and what its rules read                         */
/* -------------------------------------------------------------------------- */

// aqua_publish offers a tank's newest reading of a parameter to other
// applications and to the rules: as `<tank>.<parameter>`, and as `<parameter>`
// for the first tank, so a rule can say `no3 > 25`.
fn aqua_publish(tank: AquaTank, parameter: string, milli: i64) void {
    let label: string = aqua_parameter_label(parameter)
    let unit: string = aqua_parameter_unit(parameter)
    ignore_bool(appapi_publish(tank.handle + "." + parameter, milli_format(milli), unit, tank.name + " · " + label))
    let first: AquaTank = aqua_tank(0)
    if first.id == tank.id {
        ignore_bool(appapi_publish(parameter, milli_format(milli), unit, label))
    }
}

/* -------------------------------------------------------------------------- */
/*  Several tanks                                                             */
/* -------------------------------------------------------------------------- */

// Each tank has its own roles, rules and chores. The first tank — the one made
// first — keeps the plain names an installation of one tank has always had
// (`heater`, `keep-temperature`, `Water change`); every other tank's are its
// handle's: `reef-nano-heater`, `reef-nano-keep-temperature`, `Water change ·
// Reef nano`.

fn aqua_first_tank_id() u32 {
    let opened: Result[SqlDb, string] = aqua_open()
    if !opened.is_ok {
        return 0
    }
    let rows: AquariumTanks[32]
    let slice: Slice[AquariumTanks] = Slice[AquariumTanks]{ Ptr[AquariumTanks](&rows[0]), AQUA_TANKS }
    let listed: Result[u32, SqlError] = ListTanks(opened.ok, slice, AQUA_TANKS)
    sql_close(opened.ok)
    if listed.is_ok && listed.ok > 0 {
        return u32(rows[0].id)
    }
    return 0
}

fn aqua_is_first(tank: AquaTank) bool {
    return tank.id == 0 || tank.id == aqua_first_tank_id()
}

// aqua_prefix is what a tank's own names start with: "" for the first tank.
fn aqua_prefix(tank: AquaTank) string {
    if aqua_is_first(tank) {
        return ""
    }
    return tank.handle + "-"
}

// aqua_role_handle is the inventory handle that plays a role in a tank.
fn aqua_role_handle(tank: AquaTank, role: string) string {
    return aqua_prefix(tank) + role
}

// aqua_chore_title is a chore's title for a tank.
fn aqua_chore_title(tank: AquaTank, title: string) string {
    if aqua_is_first(tank) {
        return title
    }
    return title + " · " + tank.name
}

// aqua_live_temperature is a tank's probe now, through its heater's
// temperature binding, or "".
fn aqua_live_temperature(tank: AquaTank) string {
    return inventory_read(aqua_role_handle(tank, "heater"), "temperature")
}

// aqua_word_swap replaces a role's name where it stands as a word — `heater` in
// `switch heater on` and `heater.temperature`, not in `heaters` — by another.
fn aqua_word_swap(text: string, word: string, replacement: string) string {
    var out: string = ""
    var rest: string = text
    let n: u32 = u32(rho_strlen(word))
    while rest != "" {
        let at: i32 = rho_str_index_of(rest, word)
        if at < 0 {
            return out + rest
        }
        let i: u32 = u32(at)
        var before_ok: bool = i == 0 && out == ""
        if i > 0 {
            let before: string = rho_str_slice(rest, i - 1, 1)
            before_ok = rho_str_eq(before, " ") || rho_str_eq(before, "(") || rho_str_eq(before, ";")
        } else if out != "" {
            let last: string = rho_str_slice(out, u32(rho_strlen(out)) - 1, 1)
            before_ok = rho_str_eq(last, " ") || rho_str_eq(last, "(") || rho_str_eq(last, ";")
        }
        var after_ok: bool = i + n >= u32(rho_strlen(rest))
        if !after_ok {
            let after: string = rho_str_slice(rest, i + n, 1)
            after_ok = rho_str_eq(after, ".") || rho_str_eq(after, " ") || rho_str_eq(after, ")") || rho_str_eq(after, ";")
        }
        if before_ok && after_ok {
            out = out + rho_str_slice(rest, 0, i) + replacement
        } else {
            out = out + rho_str_slice(rest, 0, i + n)
        }
        rest = rho_str_slice(rest, i + n, u32(rho_strlen(rest)) - i - n)
    }
    return out
}

// aqua_tank_names puts a tank's names into a rule's text: its roles' handles,
// its band (`band.` names the first tank's, `<tank>.band.` another's) and its
// light hours.
fn aqua_tank_names(tank: AquaTank, text: string) string {
    var out: string = text
    if !aqua_is_first(tank) {
        var roles: string = yaml.keys(aqua_presets_path("roles"), "roles")
        while roles != "" {
            let role: string = aqua_line(roles)
            roles = aqua_after_line(roles)
            if role != "" {
                out = aqua_word_swap(out, role, aqua_role_handle(tank, role))
            }
        }
        out = aqua_word_swap(out, "band", tank.handle + ".band")
    }
    if rho_str_starts_with(out, "time between ") && tank.lights_on != "" && tank.lights_off != "" {
        out = "time between " + tank.lights_on + " and " + tank.lights_off
    }
    return out
}

// aqua_tank_setup gives a tank its rules and its chores, from the presets with
// the tank's names in them. It is asked at start for every tank and when a tank
// is added or changed; what the presets say stays what the rules say.
fn aqua_tank_setup(tank: AquaTank) void {
    if tank.id == 0 {
        return
    }
    let path: string = aqua_presets_path("rules")
    let prefix: string = aqua_prefix(tank)
    var text: string = "rules:\n"
    var rest: string = yaml.keys(path, "rules")
    while rest != "" {
        let name: string = aqua_line(rest)
        rest = aqua_after_line(rest)
        if name == "" {
            continue
        }
        text = text + "  " + prefix + name + ":\n"
        var fields: string = "when\nclear\nfor\ncooldown\ndo\nelse\n"
        while fields != "" {
            let key: string = aqua_line(fields)
            fields = aqua_after_line(fields)
            let value: string = str_trim(yaml.value(path, "rules." + name + "." + key))
            if key != "" && value != "" {
                text = text + "    " + key + ": " + aqua_tank_names(tank, value) + "\n"
            }
        }
    }
    ignore_u32(rules_presets(text))
    if aqua_is_first(tank) {
        return
    }
    // The chores a tank has of its own: the first tank's come from the presets.
    let chores: string = aqua_presets_path("schedule")
    var out: string = "chores:\n"
    var keys: string = yaml.keys(chores, "chores")
    while keys != "" {
        let key: string = aqua_line(keys)
        keys = aqua_after_line(keys)
        if key == "" || rho_str_eq(key, "clean-glass") {
            continue
        }
        out = out + "  " + prefix + key + ":\n"
        var fields: string = "title\nkind\ninterval_hours\ngrace_hours\npriority\nusage_hours\nruntime_of\nconsumes\nconsumes_qty\n"
        while fields != "" {
            let field: string = aqua_line(fields)
            fields = aqua_after_line(fields)
            var value: string = str_trim(yaml.value(chores, "chores." + key + "." + field))
            if field == "" || value == "" {
                continue
            }
            if rho_str_eq(field, "title") {
                value = aqua_chore_title(tank, value)
            } else if rho_str_eq(field, "runtime_of") {
                value = aqua_role_handle(tank, value)
            }
            out = out + "    " + field + ": " + value + "\n"
        }
    }
    ignore_u32(scheduler_presets(out))
}

fn aqua_tanks_setup() void {
    let opened: Result[SqlDb, string] = aqua_open()
    if !opened.is_ok {
        return
    }
    let rows: AquariumTanks[32]
    let slice: Slice[AquariumTanks] = Slice[AquariumTanks]{ Ptr[AquariumTanks](&rows[0]), AQUA_TANKS }
    let listed: Result[u32, SqlError] = ListTanks(opened.ok, slice, AQUA_TANKS)
    sql_close(opened.ok)
    if listed.is_ok {
        var i: u32 = 0
        while i < listed.ok {
            aqua_tank_setup(aqua_tank_of(rows[i]))
            i = i + 1
        }
    }
}

// aqua_band_value is a point of a tank's band a rule compares with: `low` and
// `high` themselves; `on` and `off`, a quarter of the band in from each end,
// where a heater switches on and off; `alarm`, two degrees past the top.
fn aqua_band_value(tank: AquaTank, parameter: string, which: string) string {
    let band: AquaBand = aqua_band(tank.id, parameter)
    if !band.known {
        return ""
    }
    let quarter: i64 = (band.high - band.low) / 4
    if rho_str_eq(which, "low") { return milli_format(band.low) }
    if rho_str_eq(which, "high") { return milli_format(band.high) }
    if rho_str_eq(which, "on") { return milli_format(band.low + quarter) }
    if rho_str_eq(which, "off") { return milli_format(band.high - quarter) }
    if rho_str_eq(which, "alarm") { return milli_format(band.high + 2000) }
    return ""
}

// rules_host_value is the aquarium's own values a rule may name, asked before an
// inventory item is read: a tank's band (`band.temperature.on` for the first
// tank, `reef-nano.band.temperature.on` for another), and its published test
// results and derived values (`no3`, `days_since_water_change`).
fn rules_host_value(ref: string) string {
    var tank: AquaTank = aqua_no_tank()
    var rest: string = ""
    if rho_str_starts_with(ref, "band.") {
        tank = aqua_tank(aqua_first_tank_id())
        rest = rho_str_slice(ref, 5, u32(rho_strlen(ref)) - 5)
    } else {
        let at: i32 = rho_str_index_of(ref, ".band.")
        if at > 0 {
            tank = aqua_tank_by_handle(rho_str_slice(ref, 0, u32(at)))
            rest = rho_str_slice(ref, u32(at) + 6, u32(rho_strlen(ref)) - u32(at) - 6)
        }
    }
    if tank.id > 0 && rest != "" {
        let dot: i32 = rho_str_index_of(rest, ".")
        if dot > 0 {
            return aqua_band_value(tank, rho_str_slice(rest, 0, u32(dot)),
                rho_str_slice(rest, u32(dot) + 1, u32(rho_strlen(rest)) - u32(dot) - 1))
        }
    }
    return appapi_value(ref)
}
