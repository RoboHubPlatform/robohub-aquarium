//
// @file shell.rho
// @brief The aquarium's own part of the RoboHub shell: the places on its rail, its feeding button, its layout.
//
// @module aquarium
// @project robohub-aquarium
// @author Aurel Miron
// @date 2026-11-13
//
// SPDX-License-Identifier: MIT
//

module aquarium

// Every page is drawn through host_shell, the aquarium's and the shared modules'
// alike (inventory, scheduler, rules, journal, widgets, appshell), so they all
// have the same top bar, rail and look (robohub.ui), in the dark or the light
// theme. What every application draws the same way — the top bar, the settings
// and docs pages — is the appshell module's; this file is what is the
// aquarium's: its places and its quick mode.

fn host_app() string {
    return "aquarium"
}

fn host_app_title() string {
    return "Aquarium"
}

// The settings tabs this application's modules add to appshell's page, each
// module's own form.
fn host_settings_tabs() string {
    return "inventory|inventory.settings_tab,scheduler|scheduler.settings_tab,widgets|widgets.settings_tab,"
}

fn host_settings_form(req: Request, tab: string, action: string) string {
    if rho_str_eq(tab, "inventory") {
        return inventory_settings_form(req, action)
    }
    if rho_str_eq(tab, "scheduler") {
        return scheduler_settings_form(req, action)
    }
    if rho_str_eq(tab, "widgets") {
        return widgets_settings_form(req, action)
    }
    return ""
}

fn host_settings_save(req: Request, tab: string, body: string) void {
    if rho_str_eq(tab, "inventory") {
        inventory_settings_save(body)
    } else if rho_str_eq(tab, "scheduler") {
        scheduler_settings_save(body)
    } else if rho_str_eq(tab, "widgets") {
        widgets_settings_save(body)
    }
}

// aqua_rail is the places, grouped as the work is: the tank, its care, what runs
// by itself, and the system.
fn aqua_rail(req: Request) string {
    let open: u32 = journal_open_count()
    return appshell_rail_link(req, "/", "◉", i18n_t(req, "nav.overview"), "", true) +
        "<h6>" + i18n_t(req, "nav.group.tank") + "</h6>" +
        appshell_rail_link(req, "/equipment", "▣", i18n_t(req, "nav.equipment"), "", true) +
        "<a class=\"sub\" href=\"/devices\">" + escape_html(i18n_t(req, "nav.devices")) + "</a>" +
        appshell_rail_link(req, "/water", "≈", i18n_t(req, "nav.water"), "", true) +
        appshell_rail_link(req, "/dosing", "⚗", i18n_t(req, "nav.dosing"), "", false) +
        appshell_rail_link(req, "/livestock", "❦", i18n_t(req, "nav.livestock"), "", false) +
        "<h6>" + i18n_t(req, "nav.group.care") + "</h6>" +
        appshell_rail_link(req, "/scheduler", "◷", i18n_t(req, "nav.schedule"), "", false) +
        appshell_rail_link(req, "/expenses", "▤", i18n_t(req, "nav.inventory"), "", false) +
        "<h6>" + i18n_t(req, "nav.group.automation") + "</h6>" +
        appshell_rail_link(req, "/rules", "⚙", i18n_t(req, "nav.rules"), "", true) +
        appshell_rail_link(req, "/journal", "☰", i18n_t(req, "nav.journal"), appshell_count(open, ""), false) +
        appshell_rail_link(req, "/widgets", "▦", i18n_t(req, "nav.dashboard"), "", false) +
        "<h6>" + i18n_t(req, "nav.group.system") + "</h6>" +
        appshell_rail_link(req, "/tank", "▭", i18n_t(req, "nav.tank"), "", false) +
        appshell_rail_link(req, "/settings", "⚑", i18n_t(req, "nav.settings"), "", false) +
        appshell_rail_link(req, "/docs", "▧", i18n_t(req, "nav.docs"), "", false)
}

fn aqua_page(req: Request, title: string, body: string) Response {
    let document: string = template_fill(template_get("layout"),
        vars("title", title) +
        vars("theme", ui_theme(req)) +
        vars("ui_head", ui_head()) +
        vars("htmx", htmx_head()) +
        i18n_vars(req) +
        vars("topbar", appshell_topbar(req, appshell_middle(req, "feeding", i18n_t(req, "top.feed")))) +
        vars("nav", aqua_rail(req)) +
        vars("body", body) +
        vars("notifications", notification_embed()) +
        vars("forms_style", forms_style()) +
        vars("widgets_style", widgets_style()))
    return html(status_ok(), document)
}

// host_shell is how every module draws a page inside the aquarium.
fn host_shell(req: Request, title: string, body: string, scripts: string) Response {
    return aqua_page(req, title, body + scripts)
}
