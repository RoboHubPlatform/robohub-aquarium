//
// @file devices.rho
// @brief The aquarium's roles — heater, light, main filter, CO₂ — as the inventory's Devices page shows them, one tank at a time.
//
// @module aquarium
// @project robohub-aquarium
// @author Aurel Miron
// @date 2026-11-14
//
// SPDX-License-Identifier: MIT
//

module aquarium

// The rules and the overview name equipment by role (`heater.temperature`,
// `switch light on`). presets/roles.yml says which roles there are and what each
// needs from the mesh; this page fills them, the way a widget is given its
// source: which inventory item plays the role, and which gateway source each of
// its capabilities is. The page is the inventory's; what is here is what it asks
// of the aquarium — the roles of the tank it is about, and which tank that is.

fn aqua_roles_path() string {
    return aqua_presets_path("roles")
}

fn aqua_role(key: string, field: string) string {
    return str_trim(yaml.value(aqua_roles_path(), "roles." + key + "." + field))
}

// One section, unnamed: the roles of the tank the page is about.
fn host_devices_sections(req: Request) string {
    return "roles|"
}

// The first tank's roles are the plain handles, another's carry its handle
// (`reef-nano-heater`) and its name in the label.
fn host_devices_roles(req: Request, section: string) string {
    let tank: AquaTank = aqua_tank_param(req)
    var out: string = ""
    var rest: string = yaml.keys(aqua_roles_path(), "roles")
    while rest != "" {
        let role: string = aqua_line(rest)
        rest = aqua_after_line(rest)
        if role == "" {
            continue
        }
        var label: string = aqua_role(role, "label")
        if !aqua_is_first(tank) {
            label = label + " · " + tank.name
        }
        out = out + aqua_role_handle(tank, role) + "|" + label + "|" + aqua_role(role, "category") + "|" +
            aqua_role(role, "capabilities") + "|" + aqua_role(role, "hint") + "\n"
    }
    return out
}

// A role is filled from any equipment; no category is listed apart from them.
fn host_devices_categories(req: Request, section: string) string {
    return ""
}

fn host_devices_query(req: Request) string {
    return "tank=" + rho_int_to_str(aqua_tank_param(req).id)
}

// With more than one tank, the page says whose roles these are and lets
// another tank's be chosen.
fn host_devices_intro(req: Request) string {
    let choices: string = aqua_tank_choices()
    if rho_str_index_of(choices, ",") < 0 {
        return ""
    }
    return "<form method=\"get\" action=\"/devices\" class=\"aq-form inline-form\"><label>" + i18n_t(req, "devices.tank") +
        "<select name=\"tank\" onchange=\"this.form.submit()\">" +
        aqua_option_list(choices, rho_int_to_str(aqua_tank_param(req).id), "") + "</select></label></form>"
}

fn host_devices_value(capability: string, text: string) string {
    return text
}

fn host_devices_added(id: u32, category: string) void {
}

fn host_devices_changed(handle: string, what: string) void {
    journal_info("device", handle, "person", what)
}
