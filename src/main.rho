module aquarium

// One service on one port. What is an aquarium's — tanks and their targets,
// water tests and changes, doses, livestock — is here, in src/aquarium. What any
// RoboHub application needs is a shared module included below: the inventory
// (equipment and its automation), the scheduler, the rules, the journal, the
// dashboard, the API the aquarium offers, the look. Devices are reached only
// through the gateway interface, from Mesh or the simulator.

include "settings"
include "i18n"
include "ui"
include "storage.rho"
include "db/models.rho"
include "db/queries.rho"
include "inventory"
include "scheduler"
include "widgets"
include "journal"
include "rules"
include "appapi"
include "logging"
include "htmx"
include "aquarium/core.rho"
include "aquarium/shell.rho"
include "aquarium/overview.rho"
include "aquarium/water.rho"
include "aquarium/care.rho"
include "aquarium/tank.rho"
include "aquarium/devices.rho"
include "aquarium/settings.rho"
include "aquarium/migrate.rho"

import std.sql
import std.web.http
import std.web.template
import rho.log
import robohub.gateway
import robohub.simulator

route GET  "/"                   => aquarium_home
route GET  "/docs"               => aquarium_docs
route GET  "/equipment"          => equipment_page
route POST "/equipment/switch"   => equipment_switch
route GET  "/water"              => water_page
route POST "/water/test"         => water_test
route POST "/water/targets"      => water_targets
route POST "/water/change"       => water_change
route GET  "/dosing"             => dosing_page
route POST "/dosing"             => dosing_add
route GET  "/livestock"          => livestock_page
route POST "/livestock"          => livestock_add
route POST "/livestock/loss"     => livestock_loss
route GET  "/devices"            => devices_page
route POST "/devices"            => devices_save
route GET  "/tank"               => tank_page
route POST "/tank"               => tank_save
route POST "/tank/add"           => tank_add
route GET  "/settings"           => aqua_settings_page
route POST "/settings"           => aqua_settings_save
// The pages of 0.4, where their work is now.
route GET  "/chemistry"          => old_chemistry
route GET  "/automation"         => old_automation
route GET  "/modes"              => old_automation
route GET  "/events"             => old_events

fn old_chemistry(req: Request) Response {
    return redirect("/water")
}

fn old_automation(req: Request) Response {
    return redirect("/rules")
}

fn old_events(req: Request) Response {
    return redirect("/journal")
}

// init seeds what the presets say — categories, rules and modes, chores, the
// values the aquarium offers, the simulated devices — moves an older
// installation's records, and makes the first tank of a new one.
fn init() void {
    log_config_apply("aquarium")
    info("aquarium", "starting")
    aqua_presets_refresh()
    ignore_u32(inventory_presets(rho_asset("aquarium", "presets/inventory.yml")))
    ignore_u32(rules_presets(rho_asset("aquarium", "presets/rules.yml")))
    ignore_u32(scheduler_presets(rho_asset("aquarium", "presets/schedule.yml")))
    ignore_u32(appapi_presets(rho_asset("aquarium", "presets/api.yml")))
    ignore_u32(simulator.presets(rho_asset("aquarium", "presets/sim.yml")))
    aqua_migrate()
    if aqua_tank(0).id == 0 {
        ignore_u32(aqua_add_tank("Aquarium", 0, "planted", "10:00", "20:00", ""))
    }
    // Every tank's rules and chores, from the presets with its own names.
    aqua_tanks_setup()
}

// background follows the live feed and refreshes the dashboard when a reading
// arrives, runs the rules every five seconds and on every reading, moves the
// simulated devices while the simulator is the gateway, keeps the values the
// aquarium offers every minute, counts equipment runtime hourly and prunes the
// journal daily.
fn background() void {
    var ticks: u32 = 0
    while true {
        ticks = ticks + 1
        if ticks % 10 == 5 && rho_str_eq(gateway.provider(), "simulator") {
            ignore_u32(simulator.tick())
        }
        let reading: bool = widgets_live_changed()
        if reading {
            ignore_u32(widgets_refresh_all())
        }
        if reading || ticks % 10 == 0 {
            ignore_u32(rules_tick())
        }
        if ticks % 120 == 10 {
            ignore_u32(appapi_tick())
        }
        // Older widgets' Mesh URLs move to stable ids even while no reading
        // arrives; nothing is asked of the gateway when none is left.
        if ticks % 120 == 30 {
            ignore_u32(widgets_migrate_sources())
        }
        if ticks % 7200 == 0 {
            ignore_u32(inventory_runtime_tick())
            ignore_u32(scheduler_usage_tick())
        }
        if ticks % 172800 == 1 {
            ignore_u32(journal_prune())
        }
        rho_sleep_ms(500)
    }
}
